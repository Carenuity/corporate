# public/.htaccess is the copy that gets deployed (copied into out/ on export).
# Keep the root .htaccess and public/.htaccess identical.

RewriteEngine On

RewriteCond %{HTTPS} off

RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rewrite URLs containing capital letters to lowercase
# Onces tested change 302 to 301 - permanent redirect
# Skip /_next/ - build assets (build ID, [universityId] chunk) are case-sensitive

RewriteCond %{REQUEST_URI} !^/_next/
RewriteCond expr "tolower(%{REQUEST_URI}) =~ /(.*)/"
RewriteRule [A-Z] %1 [R=302,L]

# Compress text assets. woff2, jpg, png, webp and mp4 are already compressed, so skip them.
# Not SetOutputFilter DEFLATE - compressing mp4 breaks byte-range (206) video seeking.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
